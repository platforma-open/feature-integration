// Per-sample QC summary assembly (feature-integration).
//
// processColumn emits the per-sample QC CSV (fb-pipeline `qc` output) as a [sampleId] -> file resource map
// (column-specs.lib.tengo qcFileMapOutput). This template concatenates the one-row CSVs into one file,
// injecting the REAL sampleId per row from the map key over the constant "sample" the Python writes.
// Its single output is that file. The verdict stage reads it through --qc-summary.
//
// It emits no p-frame. The across-samples table is built by verdict-import from result_qc_summary.csv,
// which carries the measurement set and the rolled-up status this template cannot produce.
//
// Rendered as a separate template because the resource map must be awaited before its per-sample keys can
// be iterated, which main's body cannot do inline.

self := import("@platforma-sdk/workflow-tengo:tpl")
ll := import("@platforma-sdk/workflow-tengo:ll")
maps := import("@platforma-sdk/workflow-tengo:maps")
pt := import("@platforma-sdk/workflow-tengo:pt")
columnSpecs := import(":column-specs")

json := import("json")

self.defineOutputs("qcSummaryCsv")

self.body(func(inputs) {
	qcData := inputs.qcData // ResourceMap: [sampleId] -> per-sample QC CSV file
	sampleAxisSpec := inputs.sampleAxisSpec

	columnsSpec := columnSpecs.qcSummaryColumnsSpec(sampleAxisSpec)

	// Metric column names to carry through from each per-sample CSV. The CSV's own sampleId column is
	// deliberately NOT selected: the real sampleId is injected from the resource-map key below.
	// qcSummaryColumnsSpec is read for its column NAMES only. The across-samples p-frame is built by
	// verdict-import from result_qc_summary.csv, which carries the measurement set and the rolled-up
	// status this template cannot produce.
	metricCols := []
	for col in columnsSpec.columns {
		metricCols = append(metricCols, col.column)
	}

	inputsMap := qcData.inputs()
	ll.assert(len(inputsMap) > 0, "no per-sample QC files to combine")

	wf := pt.workflow().inLightQueue().cpu(1).mem("2GiB")

	// Sorted-key iteration keeps the constructed pt sub-resource canonical, and so dedup-stable.
	dfs := []
	for key in maps.getKeys(inputsMap) {
		sampleId := json.decode(key)[0]
		df := wf.frame(inputsMap[key], { xsvType: "csv", inferSchema: false })
		selectExprs := [pt.lit(sampleId).alias("sampleId")]
		for col in metricCols {
			selectExprs = append(selectExprs, pt.col(col))
		}
		dfs = append(dfs, df.select(selectExprs...))
	}

	combined := len(dfs) > 1 ? pt.concat(dfs) : dfs[0]
	combined.save("qc-summary.csv", { xsvType: "csv" })

	wfResult := wf.run()
	csvFile := wfResult.getFile("qc-summary.csv")

	return {
		// The combined table as a FILE. The verdict stage reads its read counts through --qc-summary.
		// Returned here rather than concatenated a second time because the two must agree: the per-sample
		// sampleId is injected from the resource-map key, so a second gather could key the rows differently,
		// and the verdict stage would then match no sample and evaluate nothing.
		qcSummaryCsv: csvFile
	}
})
