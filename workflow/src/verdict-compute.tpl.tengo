// The verdict stage's compute: the three cross-sample gathers and emit_verdicts.py.
//
// Its inputs carry no project-specific value: the per-sample maps, the linker and the sample-label map are
// keyed by anonymized sample ids, and there is no blockId. So another project over the same data reuses the
// results. main keeps every output for that.
//
// The results are keyed by anonymized ids; verdict-deanonymize.tpl.tengo translates them back.

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
maps := import("@platforma-sdk/workflow-tengo:maps")
va := import(":verdict-args")
tables := import(":verdict-tables")

verdictsSw := assets.importSoftware("@platforma-open/milaboratories.feature-integration.verdicts:emit-verdicts")

gatherCountsTpl := assets.importTemplate(":gather-counts")
gatherRawFeatureCountsTpl := assets.importTemplate(":gather-raw-feature-counts")
qcSummaryTpl := assets.importTemplate(":qc-summary")

outputNames := []
for table in tables.RESULT_TABLES {
	outputNames = append(outputNames, table.out)
}
for content in tables.CONTENT_OUTPUTS {
	outputNames = append(outputNames, content.out)
}
self.defineOutputs(outputNames...)

self.body(func(inputs) {
	// The reading is done across the whole run, so the per-sample counts are gathered into one table first.
	// A child template, because the file map must be awaited before its keys can be iterated.
	countsFile := render.create(gatherCountsTpl, {
		tagstatData: inputs.tagstatData,
		tags: inputs.tags
	}).output("countsFile")

	// Pre-refine FEATURE counts, gathered the same way, for the undeclared-barcode table. refine-tags snaps
	// every barcode onto the panel, so an undeclared sequence is only visible before it.
	rawFeatureCountsFile := render.create(gatherRawFeatureCountsTpl, {
		rawFeatureData: inputs.rawFeatureData
	}).output("rawCountsFile")

	// The combined per-sample read QC, the only source of readsTotal, panelAssignedFraction and readsPerCell.
	qcSummaryFile := render.create(qcSummaryTpl, {
		qcData: inputs.qcData
	}).output("qcSummaryCsv")

	params := maps.merge(inputs.params, {
		hasLinker: true,
		hasQcSummary: true,
		hasRawFeatureCounts: true
	})
	// Only with a sample column: without one there is a single panel and no sample name to translate.
	if !is_undefined(params.sampleColumn) && params.sampleColumn != "" {
		params.sampleLabels = inputs.sampleLabels
	}

	// Memory scales with the gathered counts table. Measured peak: 614 bytes of RSS per counts row, 9.6x the
	// file (44 samples, 28.5M rows). 24x leaves headroom for narrower rows and denser linkers, and keeps a
	// 2 GiB counts file within 64 GiB. The earlier 8x was killed on a 1.83 GB counts file.
	formula := exec.formula
	memFormula := formula.gib(16).
		plus(formula.size("counts").times(24)).
		between(formula.gib(16), formula.gib(256)).
		staticFallback(formula.gib(16))

	b := exec.builder().
		software(verdictsSw).
		resources({ onCPU: { cpu: 4, ram: memFormula } }).
		// Cap polars' thread pool (all host cores by default) to the granted CPU.
		envWithVar("POLARS_MAX_THREADS", "{system.cpu}").
		addFile(va.FILE_COUNTS, countsFile, { tag: "counts" }).
		addFile(va.FILE_PANEL, inputs.panelFile).
		addFile(va.FILE_LINKER, inputs.linkerFile).
		addFile(va.FILE_QC_SUMMARY, qcSummaryFile).
		addFile(va.FILE_RAW_FEATURE_COUNTS, rawFeatureCountsFile)

	for a in va.build(params) {
		b = b.arg(a)
	}
	for table in tables.RESULT_TABLES {
		b = b.saveFile(table.file)
	}
	for content in tables.CONTENT_OUTPUTS {
		b = b.saveFileContent(content.file)
	}
	run := b.run()

	// The run record and QC reports are returned as content, since they are read as values; the tables as
	// files, for the imports. One field per output, since an exec result cannot be a template output.
	result := {}
	for table in tables.RESULT_TABLES {
		result[table.out] = run.getFile(table.file)
	}
	for content in tables.CONTENT_OUTPUTS {
		result[content.out] = run.getFileContent(content.file)
	}
	return result
})
