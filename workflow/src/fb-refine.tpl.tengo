// refine-tags sub-template (render.create boundary): emit the feature panel, then refine-tags.
//
// Returns refined.mic, refine_report.json and a live stdout stream (refineLogStream). Capturing stdout is
// safe only because main.tpl content-hash-persists the mitool intermediates, which is what prevents
// CIDConflictError. Only the refine-tags exec streams; the deterministic panel-emit exec does not, so its
// panel.txt is safe to feed refine.addFile.
//
// refine-tags error-corrects cell, feature and UMI barcodes. FEATURE snaps to the panel whitelist
// (#file:panel.txt): a within-Hamming-1 read snaps to a panel barcode, and an off-panel read is dropped.
// CELL is de-novo corrected by default, and a chemistry whitelist snaps it to a 10x built-in
// (#builtin:<name>).

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")

self.defineOutputs("refinedMic", "refineReport", "refineLogStream")

mitoolSw := assets.importSoftware("@platforma-open/milaboratories.software-mitool:memory-from-limits")
emitPanelSw := assets.importSoftware("@platforma-open/milaboratories.feature-integration.per-cell-metrics:emit-panel")

// mitool progress-line marker (see fb-parse.tpl.tengo). Drives the model's per-step live log and progress.
progressPrefix := "[==PROGRESS==]"

self.body(func(inputs) {
	parsedMic := inputs.parsedMic
	tags := inputs.tags // { cell, umi, feature } tag names (from the model; see pattern.ts)
	tagsCsv := inputs.tagsCsv
	barcodeSeqColumn := inputs.barcodeSeqColumn
	cellWhitelist := inputs.cellWhitelist // "" = de-novo CELL correction, the default. Else a 10x built-in.
	mitoolCPUs := inputs.mitoolCPUs
	memBaseGB := inputs.mitoolBaseMemGB
	memOverrideGB := inputs.mitoolMemOverrideGB // 0 = formula-sized. >0 = a fixed request.

	// Build the feature-barcode panel (panel.txt) from the tag->feature CSV. With no sample column the CSV is
	// identical across samples, so this exec dedups across them by CID on the same tags.csv input. In
	// sample-aware mode tagsCsv is already the per-sample filtered file, so the panel is per-sample and must
	// NOT be shared. Never collapse this into one panel for all samples.
	panel := exec.builder().
		software(emitPanelSw).
		cpu(1).
		mem("2GiB").
		addFile("tags.csv", tagsCsv).
		arg("tags.csv").arg("panel.txt").
		arg("--tag-col").arg(barcodeSeqColumn).
		saveFile("panel.txt").
		run()

	// RAM = base + reads*4, capped at 256 GiB, mirroring mixcr-analyze. The static fallback is base.
	formula := exec.formula
	memFormula := formula.gib(memBaseGB).
		plus(formula.size("reads").times(4)).
		between(formula.gib(memBaseGB), formula.gib(256)).
		staticFallback(formula.gib(memBaseGB))

	cellTag := tags.cell
	if !is_undefined(cellWhitelist) && cellWhitelist != "" {
		cellTag = tags.cell + "#builtin:" + cellWhitelist
	}

	refine := exec.builder().
		printErrStreamToStdout().
		saveStdoutStream().
		env("MI_PROGRESS_PREFIX", progressPrefix).
		software(mitoolSw)
	if memOverrideGB > 0 {
		refine = refine.cpu(mitoolCPUs).mem(string(memOverrideGB) + "GiB")
	} else {
		refine = refine.resources({ onCPU: { cpu: mitoolCPUs, ram: memFormula } })
	}
	refine = refine.
		arg("refine-tags").
		arg("-t").arg(cellTag).
		arg("-t").arg(tags.feature + "#file:panel.txt").
		arg("-t").arg(tags.umi).
		arg("--json-report").arg("refine_report.json").saveFile("refine_report.json").
		addFile("panel.txt", panel.getFile("panel.txt")).
		addFile("parsed.mic", parsedMic, { tag: "reads" }).
		arg("parsed.mic").arg("refined.mic").saveFile("refined.mic").
		run()

	return {
		refinedMic: refine.getFile("refined.mic"),
		refineReport: refine.getFile("refine_report.json"),
		refineLogStream: refine.getStdoutStream()
	}
})
