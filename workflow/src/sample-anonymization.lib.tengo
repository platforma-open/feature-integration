// Helpers to translate sample ids to and from the anonymized ids of anonymize.anonymizePKeys, whose
// `mapping` is {anonymizedId: sampleId}.

maps := import("@platforma-sdk/workflow-tengo:maps")
slices := import("@platforma-sdk/workflow-tengo:slices")
pt := import("@platforma-sdk/workflow-tengo:pt")

// invert: {a: b} -> {b: a}. Exact, since both sides are unique.
invert := func(mapping) {
	result := {}
	maps.forEach(mapping, func(key, value) {
		result[value] = key
	})
	return result
}

// rekey: a copy of `m` with its keys translated. Unknown keys are kept.
rekey := func(m, translation) {
	result := {}
	maps.forEach(m, func(key, value) {
		newKey := translation[key]
		result[is_undefined(newKey) ? key : newKey] = value
	})
	return result
}

// translateList: a copy of `list` with its elements translated. Unknown elements are kept.
translateList := func(list, translation) {
	return slices.map(list, func(value) {
		newValue := translation[value]
		return is_undefined(newValue) ? value : newValue
	})
}

// replaceValues: a pt expression translating each whole value of `colExpr`; unknown values are kept. Built
// in sorted key order, so the same translation always gives the same workflow.
replaceValues := func(colExpr, translation) {
	whenExpr := undefined
	maps.forEach(translation, func(from, to) {
		condition := colExpr.eq(pt.lit(from))
		if is_undefined(whenExpr) {
			whenExpr = pt.when(condition).then(pt.lit(to))
		} else {
			whenExpr = whenExpr.when(condition).then(pt.lit(to))
		}
	})
	if is_undefined(whenExpr) {
		return colExpr
	}
	return whenExpr.otherwise(colExpr)
}

// replaceSubstrings: a pt expression replacing every occurrence of each key inside `colExpr`, for columns
// that join several sample ids into one string. Longest keys first, so "X-1" cannot clip "X-10".
replaceSubstrings := func(colExpr, translation) {
	keys := slices.quickSortFn(maps.getKeys(translation), func(a, b) {
		return len(a) > len(b) || (len(a) == len(b) && a < b)
	})
	expr := colExpr
	for key in keys {
		expr = expr.strReplace(key, translation[key], { literal: true, replaceAll: true })
	}
	return expr
}

export {
	invert: invert,
	rekey: rekey,
	translateList: translateList,
	replaceValues: replaceValues,
	replaceSubstrings: replaceSubstrings
}
