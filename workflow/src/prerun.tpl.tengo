// Prerun (staging) template.
//
// Its sole job is to import the user-uploaded tag->feature CSV and export it. Exporting the blob makes
// the staging phase DEMAND it, which drives the client upload during staging (the same way
// blocks/immune-assay-data prerun.tpl.tengo drives its file upload).
//
// Why this is necessary: the production workflow consumes the CSV only deep inside the processColumn
// fan-out (as a shared `extra` blob handed to each per-sample body's exec). The upload driver never
// picks up an upload that is requested only from inside that nested body, so the per-sample mitool exec
// stalls forever waiting on a blob whose bytes are never pushed. Driving the upload here in staging
// materialises the blob before production runs, so by the time the body needs it, it is ready.

wf := import("@platforma-sdk/workflow-tengo:workflow")
file := import("@platforma-sdk/workflow-tengo:file")

wf.body(func(args) {
	// Before the user uploads a CSV the handle is absent — nothing to drive yet.
	if is_undefined(args.tagFeatureCsvHandle) {
		return { outputs: {}, exports: {} }
	}

	csvImport := file.importFile(args.tagFeatureCsvHandle)

	return {
		outputs: {
			csvFile: file.exportFile(csvImport.file)
		},
		exports: {}
	}
})
