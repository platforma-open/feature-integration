// Gated refine + tag-stat (render.create boundary).
//
// Branches on the parse gate's decision (parse_gate.py -> decision.json, read here via .getData() — file
// content can only be inspected inside a template that receives the file, hence this sub-template).
//   • matched > 0  -> the normal chain: refine-tags (fb-refine) then tag-stat (fb-tagstat).
//   • matched == 0 -> mitool wrote no parsed.mic (fb-parse pre-wrote an empty placeholder), so refine /
//                     tag-stat would crash on it. Skip both and return the header-only tag-stat TSV +
//                     empty refine report the gate already synthesized. The downstream Python is
//                     empty-safe (a header-only tag-stat yields empty results), so the sample completes
//                     with zero cells instead of failing the whole block.
// Pure routing: no exec of its own (the gate produced the fallbacks), so both branches just wire files.

self := import("@platforma-sdk/workflow-tengo:tpl")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")

json := import("json")

fbRefineTpl := assets.importTemplate(":fb-refine")
fbTagstatTpl := assets.importTemplate(":fb-tagstat")

self.defineOutputs("tagstatTsv", "refineReport")

self.body(func(inputs) {
	shouldContinue := json.decode(string(inputs.decision.getData())).shouldContinue

	tags := inputs.tags

	if !shouldContinue {
		// No-match branch: use the gate's header-only tag-stat + empty refine report.
		return {
			tagstatTsv: inputs.emptyTagstat,
			refineReport: inputs.emptyRefineReport
		}
	}

	// Normal branch: refine-tags -> tag-stat, each in its own render boundary (unchanged).
	refineRun := render.create(fbRefineTpl, {
		parsedMic: inputs.parsedMic,
		tags: tags,
		tagsCsv: inputs.tagsCsv,
		barcodeSeqColumn: inputs.barcodeSeqColumn,
		cellWhitelist: inputs.cellWhitelist,
		mitoolCPUs: inputs.mitoolCPUs,
		mitoolBaseMemGB: inputs.mitoolBaseMemGB,
		mitoolMemOverrideGB: inputs.mitoolMemOverrideGB
	})

	tagStatRun := render.create(fbTagstatTpl, {
		refinedMic: refineRun.output("refinedMic"),
		tags: tags
	})

	return {
		tagstatTsv: tagStatRun.output("tagstatTsv"),
		refineReport: refineRun.output("refineReport")
	}
})
