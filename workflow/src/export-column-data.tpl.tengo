// Exports column data for the UI (pframes.exportColumnData, what pframes.exportFrame does per column).
//
// Pure, so a later run over the same data reuses the export. It takes data only; main attaches the specs,
// which carry blockId.
//
// Inputs: one `column.<key>` per column. Output: `data` = {<key>: exported column data}.

self := import("@platforma-sdk/workflow-tengo:tpl")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
smart := import("@platforma-sdk/workflow-tengo:smart")
maps := import("@platforma-sdk/workflow-tengo:maps")
text := import("text")

self.defineOutputs("data")

self.body(func(inputs) {
	result := smart.mapBuilder()
	maps.forEach(self.rawInputs(), func(name, field) {
		if text.has_prefix(name, "column.") {
			result.addRef(name[7:], pframes.exportColumnData(field.getValue()))
		}
	})
	return {
		data: result.lockAndBuild()
	}
})
