// Per-sample feature-barcode pipeline (processColumn body).
//
// One invocation per sample group (the FASTQ column is aggregated over lane + readIndex). Runs the
// mitool chain — parse -> refine-tags -> tag-stat -u — to produce per-(cell, feature-barcode)
// distinct-UMI counts, then hands that table plus the user's tag->feature CSV to the per-cell-metrics
// Python software, which collapses to the (cell x feature) outputs (spec A-0010/A-0012/A-0014).
//
// refine-tags corrects the FEATURE barcode against the panel whitelist (the tag column of the user's
// CSV, emitted as panel.txt by the emit-panel step): reads within Hamming-1 of a panel barcode snap
// onto it, off-panel reads are dropped (mitool#87 fixed the `-t TAG#file:` CLI; spec A-0018 leaves the
// scheme to implementation). Tag names (CELL / FEATURE / UMI) are baked into the pattern by
// tag-pattern.lib.tengo and reused here. R1/R2 file-group handling follows blocks/peptide-extraction.

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
maps := import("@platforma-sdk/workflow-tengo:maps")
ll := import("@platforma-sdk/workflow-tengo:ll")
pConstants := import("@platforma-sdk/workflow-tengo:pframes.constants")
pcolumn := import("@platforma-sdk/workflow-tengo:pframes.pcolumn")
tagPattern := import(":tag-pattern")

json := import("json")

self.defineOutputs("abundance", "fractions", "consensus", "specificity", "tagstat", "qc", "stepLogs")

// :memory-from-limits sizes the JVM heap from the granted limits — avoids end-of-parse OOM when many
// tag writers flush (see demultiplex-fastq).
mitoolSw := assets.importSoftware("@platforma-open/milaboratories.software-mitool:memory-from-limits")
metricsSw := assets.importSoftware("@platforma-open/milaboratories.feature-integration.per-cell-metrics:main")
emitPanelSw := assets.importSoftware("@platforma-open/milaboratories.feature-integration.per-cell-metrics:emit-panel")
qcReportSw := assets.importSoftware("@platforma-open/milaboratories.feature-integration.per-cell-metrics:qc-report")

self.body(func(inputs) {
	inputData := inputs[pConstants.VALUE_FIELD_NAME]
	aggregationAxesNames := inputs[pConstants.AGGREGATION_AXES_NAMES_FIELD_NAME]

	pattern := inputs.pattern
	tagsCsv := inputs.tagsCsv
	dominanceThreshold := inputs.dominanceThreshold
	control := inputs.control // may be undefined / "" -> no specificity score
	fileExtension := inputs.fileExtension
	mitoolCPUs := inputs.mitoolCPUs
	barcodeSeqColumn := inputs.barcodeSeqColumn
	featureNameColumn := inputs.featureNameColumn
	cellWhitelist := inputs.cellWhitelist // "" = de-novo CELL correction (default); else a 10x built-in

	// mitool memory (mixcr semantics): an explicit per-process override (Advanced Settings) is a hard
	// fixed request; otherwise size RAM from the input reads' stored (compressed) blob size on top of a
	// floor. parse OOMs at end-of-parse when many tag writers flush, and that scales with input volume
	// (see mixcr-clonotyping mixcr-analyze.tpl / blocks/demultiplex-fastq). `size("reads")` reads only
	// blob metadata (no decompress, no pre-exec); on backends that cannot evaluate formulas, memFormula
	// falls back to the floor.
	formula := exec.formula
	memBaseGB := inputs.mitoolBaseMemGB
	mitoolMemFormula := formula.clamp(
		formula.add(formula.gib(memBaseGB), formula.mul(formula.size("reads"), 4)),
		formula.gib(memBaseGB),
		formula.gib(128))
	mitoolMemFallback := string(memBaseGB) + "GiB"
	// Apply the mem request to a builder: fixed when overridden, else the size formula.
	applyMitoolMem := func(b) {
		if is_undefined(inputs.mitoolMemOverrideGB) {
			return b.memFormula(mitoolMemFormula, { fallback: mitoolMemFallback })
		}
		return b.mem(string(inputs.mitoolMemOverrideGB) + "GiB")
	}

	// tag-stat's distinct-UMI on-disk sort and the per-cell-metrics polars read both scale with input
	// volume, so size their RAM from the relevant input blob instead of a fixed 8 GiB (same mixcr-style
	// size formula as parse/refine). Sizing inputs differ: tag-stat by refined.mic (molecules),
	// per-cell-metrics by tagstat.tsv (the (cell, feature) rows it reads into polars); the metrics
	// multiplier is larger because that step also materialises Python row-objects on top of the frame.
	// Both fall back to the floor where formulas can't be evaluated and clamp at 128 GiB. NOTE: the
	// Advanced-Settings per-process memory override applies to parse/refine only, not to these two.
	tagStatBaseGB := 8
	tagStatMemFormula := formula.clamp(
		formula.add(formula.gib(tagStatBaseGB), formula.mul(formula.size("mic"), 4)),
		formula.gib(tagStatBaseGB),
		formula.gib(128))
	metricsBaseGB := 8
	metricsMemFormula := formula.clamp(
		formula.add(formula.gib(metricsBaseGB), formula.mul(formula.size("tagstat"), 8)),
		formula.gib(metricsBaseGB),
		formula.gib(128))

	ll.assert(!is_undefined(pattern) && pattern != "", "tag pattern is required")

	meta := inputData.getDataAsJson()
	fileMap := inputData.inputs()

	// Collect R1/R2 FASTQ files and build the mitool input arg from the aggregation layout
	// (readIndex -> R1/R2; optional lane). Feature barcoding is paired: cell+UMI on R1, feature on R2.
	R1Files := []
	R2Files := []
	inputArg := ""
	if meta.keyLength == 1 {
		ll.assert(
			aggregationAxesNames == ["pl7.app/sequencing/readIndex"],
			"unexpected aggregation axes names: " + json.encode(aggregationAxesNames)
		)
		for sKey in maps.getKeys(fileMap) {
			key := json.decode(sKey)
			if key[0] == "R1" {
				R1Files = append(R1Files, { name: "input_R1." + fileExtension, file: fileMap[sKey] })
			} else if key[0] == "R2" {
				R2Files = append(R2Files, { name: "input_R2." + fileExtension, file: fileMap[sKey] })
			}
		}
		inputArg = "input_{{R}}." + fileExtension
	} else if meta.keyLength == 2 {
		ll.assert(
			aggregationAxesNames == ["pl7.app/sequencing/lane", "pl7.app/sequencing/readIndex"],
			"unexpected aggregation axes names: " + json.encode(aggregationAxesNames)
		)
		for sKey in maps.getKeys(fileMap) {
			key := json.decode(sKey)
			lane := key[0]
			r := key[1]
			if r == "R1" {
				R1Files = append(R1Files, { name: "input_L" + lane + "_R1." + fileExtension, file: fileMap[sKey] })
			} else if r == "R2" {
				R2Files = append(R2Files, { name: "input_L" + lane + "_R2." + fileExtension, file: fileMap[sKey] })
			}
		}
		inputArg = "input_L{{n}}_{{R}}." + fileExtension
	} else {
		ll.panic("feature-barcode parsing requires paired (R1/R2) reads; unsupported key layout: %v", meta.keyLength)
	}

	ll.assert(len(R1Files) > 0, "no R1 FASTQ files found")
	ll.assert(len(R2Files) > 0, "no R2 FASTQ files found (feature barcode is read from R2)")

	// Step 1: mitool parse — extract CELL + UMI (R1) and the feature barcode FEATURE (R2).
	parse := applyMitoolMem(exec.builder().
		software(mitoolSw).
		cpu(mitoolCPUs)).
		env("MI_PROGRESS_PREFIX", "parse").
		arg("parse").
		arg("--pattern").arg(pattern).
		arg("--threads").argWithVar("{system.cpu}")
	for f in R1Files { parse = parse.addFile(f.name, f.file, { tag: "reads" }) }
	for f in R2Files { parse = parse.addFile(f.name, f.file, { tag: "reads" }) }
	// TODO(feature-integration): parse_report.txt / refine_report.txt are written by mitool (--report)
	// and saveFile'd so they survive as retrievable exec outputs, but nothing consumes them yet — they
	// are NOT collected by main.tpl's processColumn or surfaced in the model/UI. They were kept as the
	// raw material for a future "reports" QC surface (a text/file view distinct from the stepLogs stream,
	// which already carries mitool's stderr summaries). If no reports UI has been built and these are
	// still unconsumed, drop the two --report/saveFile pairs to remove the dead work.
	parse = parse.
		arg("--report").arg("parse_report.txt").saveFile("parse_report.txt").
		arg("--json-report").arg("parse_report.json").saveFile("parse_report.json").
		arg(inputArg).arg("parsed.mic").saveFile("parsed.mic").
		printErrStreamToStdout().saveStdoutStream().run()

	// Step 2a: build the feature-barcode panel (panel.txt) from the user's tag->feature CSV. The panel
	// is sample-independent, so this dedups across samples (pure template, same tags.csv input).
	panel := exec.builder().
		software(emitPanelSw).
		cpu(1).
		mem("2GiB").
		addFile("tags.csv", tagsCsv).
		arg("tags.csv").arg("panel.txt").
		arg("--tag-col").arg(barcodeSeqColumn).
		saveFile("panel.txt").
		printErrStreamToStdout().saveStdoutStream().run()

	// Step 2b: refine-tags — error-correct cell, feature, and UMI barcodes. FEATURE is corrected against
	// the panel whitelist (#file:panel.txt): within-Hamming-1 reads snap to a panel barcode and off-panel
	// reads are dropped. CELL is de-novo corrected by default; when a chemistry whitelist is selected it
	// snaps to that 10x built-in (#builtin:<name>, the same #-address mechanism as the FEATURE panel) so
	// cellIds match the VDJ producer by construction (docs/dormant-features/cell-whitelist-correction-plan.md). The tag
	// order scopes UMI dedup to (cell, feature).
	cellTag := tagPattern.CELL_TAG
	if !is_undefined(cellWhitelist) && cellWhitelist != "" {
		cellTag = tagPattern.CELL_TAG + "#builtin:" + cellWhitelist
	}
	refine := applyMitoolMem(exec.builder().
		software(mitoolSw).
		cpu(mitoolCPUs)).
		arg("refine-tags").
		arg("-t").arg(cellTag).
		arg("-t").arg(tagPattern.FEATURE_TAG + "#file:panel.txt").
		arg("-t").arg(tagPattern.UMI_TAG).
		arg("--report").arg("refine_report.txt").saveFile("refine_report.txt").
		arg("--json-report").arg("refine_report.json").saveFile("refine_report.json").
		addFile("panel.txt", panel.getFile("panel.txt")).
		addFile("parsed.mic", parse.getFile("parsed.mic"), { tag: "reads" }).
		arg("parsed.mic").arg("refined.mic").saveFile("refined.mic").
		printErrStreamToStdout().saveStdoutStream().run()

	// Step 3: tag-stat -u — per-(cell, feature-barcode) distinct-UMI counts.
	// Output columns: CELL FEATURE count totalWeight unique_UMI
	// --use-local-temp puts the count-unique on-disk sort in the exec work dir instead of the shared
	// system /tmp — team convention for heavy on-disk-sort mitool steps (peptide-extraction mitool sort,
	// mixcr-shm-trees, miltenyi cite silent /tmp-exhaustion hangs). Supported since mitool #84 (present in
	// the pinned 2.3.1-131-main). tag-stat -u does exactly such a hierarchical on-disk sort.
	tagStat := exec.builder().
		software(mitoolSw).
		cpu(2).
		memFormula(tagStatMemFormula, { fallback: string(tagStatBaseGB) + "GiB" }).
		arg("tag-stat").
		arg("--use-local-temp").
		arg("-t").arg(tagPattern.CELL_TAG).
		arg("-t").arg(tagPattern.FEATURE_TAG).
		arg("-u").arg(tagPattern.UMI_TAG).
		addFile("refined.mic", refine.getFile("refined.mic"), { tag: "mic" }).
		arg("refined.mic").arg("tagstat.tsv").saveFile("tagstat.tsv").
		printErrStreamToStdout().saveStdoutStream().run()

	// Per-sample QC summary: reads parsed/matched (parse JSON report) + cell/feature/UMI metrics
	// (tag-stat) + best-effort panel-assigned fraction (refine JSON report).
	qc := exec.builder().
		software(qcReportSw).
		cpu(1).mem("2GiB").
		addFile("tagstat.tsv", tagStat.getFile("tagstat.tsv")).
		addFile("parse_report.json", parse.getFile("parse_report.json")).
		addFile("refine_report.json", refine.getFile("refine_report.json")).
		arg("tagstat.tsv").
		arg("--parse-report").arg("parse_report.json").
		arg("--refine-report").arg("refine_report.json").
		arg("--sample-id").arg("sample").
		arg("--cell-col").arg(tagPattern.CELL_TAG).
		arg("--feature-col").arg(tagPattern.FEATURE_TAG).
		arg("--umi-col").arg("unique_" + tagPattern.UMI_TAG).
		arg("--output").arg("result_qc.csv").saveFile("result_qc.csv").
		printErrStreamToStdout().saveStdoutStream().run()

	// Step 4: per-cell metrics (Python). sampleId is irrelevant here — processColumn prepends the
	// real sample axis from the iteration key, so we pass a constant and the CSV's sampleId column is
	// ignored by the import. Column args match the mitool tag names + the tag-stat -u output.
	hasControl := !is_undefined(control) && control != ""
	metrics := exec.builder().
		software(metricsSw).
		cpu(2).
		memFormula(metricsMemFormula, { fallback: string(metricsBaseGB) + "GiB" }).
		addFile("tagstat.tsv", tagStat.getFile("tagstat.tsv"), { tag: "tagstat" }).
		addFile("tags.csv", tagsCsv).
		arg("tagstat.tsv").arg("tags.csv").
		arg("--sample-id").arg("sample").
		arg("--cell-col").arg(tagPattern.CELL_TAG).
		arg("--feature-tag-col").arg(tagPattern.FEATURE_TAG).
		arg("--umi-count-col").arg("unique_" + tagPattern.UMI_TAG).
		arg("--csv-barcode-col").arg(barcodeSeqColumn).
		arg("--csv-feature-col").arg(featureNameColumn).
		arg("--dominance-threshold").arg(string(dominanceThreshold)).
		arg("--output-prefix").arg("result").
		saveFile("result_abundance.csv").
		saveFile("result_fractions.csv").
		saveFile("result_consensus.csv").
		saveFile("result_specificity.csv")
	if hasControl {
		metrics = metrics.arg("--control").arg(control)
	}
	metrics = metrics.printErrStreamToStdout().saveStdoutStream().run()

	// One high-level analysis log per sample, surfaced as the block's single "Analysis logs" view. The
	// qc step runs last and has every stage's numbers, so qc_report.py prints a milestone narrative of
	// the whole run to stdout; that stream is the analysis log. The individual mitool/Python step
	// streams are deliberately NOT surfaced — one readable log, not a box per tool step (per-step stdout
	// is still saved on each exec for backend retrieval / debugging). keyLength 1; processColumn
	// prepends the sample axis, giving a [sampleId, step] resource map with the single "analysis" key.
	stepLogs := pcolumn.resourceMapBuilder(1)
	stepLogs.add(["analysis"], qc.getStdoutStream())

	// The body must return exactly the defineOutputs set and no output may be undefined. specificity is
	// meaningful only with a control feature, so the Python always writes result_specificity.csv (empty
	// header-only when no --control) and we always return it. main.tpl and the model still gate the
	// specificity *import* on hasControl, so the empty file is simply never read when there is no control.
	return {
		abundance: metrics.getFile("result_abundance.csv"),
		fractions: metrics.getFile("result_fractions.csv"),
		consensus: metrics.getFile("result_consensus.csv"),
		specificity: metrics.getFile("result_specificity.csv"),
		tagstat: tagStat.getFile("tagstat.tsv"),
		qc: qc.getFile("result_qc.csv"),
		stepLogs: stepLogs.build()
	}
})
