// Builds the mitool `--pattern` for single-cell feature-barcode reads from the read geometry.
//
// mitool (>= 2.3.1-129-main, PR milaboratory/mitool#86) recognises FEATURE as a first-class tag type:
// a group name beginning with FEATURE / FB registers as type Feature, ordered CELL < FEATURE < UMI in
// the grouping hierarchy. The cell barcode is `CELL`, the feature barcode is `FEATURE`, the molecule
// is `UMI`. Downstream: `refine-tags -t CELL -t FEATURE -t UMI` (FEATURE corrected within each cell;
// UMI deduped within each (cell, feature)), then `tag-stat -t CELL -t FEATURE -u UMI` yields
// per-(cell, feature-barcode) distinct-UMI counts (columns CELL FEATURE count totalWeight unique_UMI).
//
// Geometry defaults are 10x 5' v2 (CELL 16 + UMI 10 on R1; feature barcode 15 on R2), with the
// feature barcode assumed to start at R2 position 0. The exact geometry for a given BEAM assay must
// be confirmed against real FASTQs (Task 0 / DP-1) — it is a configurable block input
// ("parameterize + proceed"), not a hardcoded assumption.

// Tag names mitool registers for this pipeline (see above). Exported so the workflow templates and
// the Python invocation stay in sync with the names baked into the pattern.
CELL_TAG := "CELL"
FEATURE_TAG := "FEATURE"
UMI_TAG := "UMI"

// Sentinel mitool prepends to progress lines (set as MI_PROGRESS_PREFIX on each mitool exec). The three
// exec templates (fb-parse/fb-refine/fb-tagstat) and the model (ProgressPrefix in model/src/index.ts,
// which parses these lines) must all use this exact string — the single tengo source lives here so the
// templates cannot drift. The model redeclares the same literal across the TS boundary; keep them equal.
PROGRESS_PREFIX := "[==PROGRESS==]"

// build assembles the mitool tag pattern from the cell / UMI / feature-barcode geometry.
//   geom = { cellLen: int, umiLen: int, featureLen: int, paired: bool }
// paired: R1 carries CELL+UMI, R2 carries the feature barcode (+ ignored remainder).
// single: one read carries CELL+UMI+feature barcode in sequence.
build := func(geom) {
	cell := "(" + CELL_TAG + ":N{" + string(geom.cellLen) + "})"
	umi := "(" + UMI_TAG + ":N{" + string(geom.umiLen) + "})"
	feat := "(" + FEATURE_TAG + ":N{" + string(geom.featureLen) + "})"
	if geom.paired {
		// R1: cell + umi ; R2: feature barcode + ignored remainder (captured as R2 payload).
		return "^" + cell + umi + "\\^" + feat + "(R2:*)"
	}
	// single read: cell + umi + feature barcode in sequence.
	return "^" + cell + umi + feat
}

export {
	build: build,
	CELL_TAG: CELL_TAG,
	FEATURE_TAG: FEATURE_TAG,
	UMI_TAG: UMI_TAG,
	PROGRESS_PREFIX: PROGRESS_PREFIX
}
