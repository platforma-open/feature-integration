// tag-stat sub-template (render.create boundary).
//
// tag-stat -u computes per-(cell, feature-barcode) distinct-UMI counts and returns tagstat.tsv to the
// caller. Progress capture (saveStdoutStream) is deliberately NOT used — see fb-parse.tpl.tengo for why
// (it injects a drifting stdout file into the exec's files map and caused the CIDConflictError). Output
// columns: CELL FEATURE count totalWeight unique_UMI.
//
// --use-local-temp puts the count-unique on-disk sort in the exec work dir instead of the shared system
// /tmp — team convention for heavy on-disk-sort mitool steps (peptide-extraction, mixcr-shm-trees,
// miltenyi cite silent /tmp-exhaustion hangs).

self := import("@platforma-sdk/workflow-tengo:tpl")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")

// mitool emits progress on stderr with this prefix; printErrStreamToStdout() folds it into the captured
// stdout stream so the model can parse live progress lines from it.
progressPrefix := "[==PROGRESS==]"

self.defineOutputs("tagstatTsv", "tagstatLogStream")

mitoolSw := assets.importSoftware("@platforma-open/milaboratories.software-mitool:memory-from-limits")

self.body(func(inputs) {
	refinedMic := inputs.refinedMic
	tags := inputs.tags // { cell, umi, feature } tag names (from the model; see pattern.ts)

	// The distinct-UMI on-disk sort scales with input volume, so size RAM from the refined.mic blob
	// (molecules) on a floor instead of a fixed request (same mixcr-style size formula as parse/refine).
	tagStatBaseGB := 8
	// workflow-tengo 6.7.0 fluent formula API fed via .resources({ onCPU }) (see fb-parse for the note).
	formula := exec.formula
	memFormula := formula.gib(tagStatBaseGB).
		plus(formula.size("mic").times(4)).
		between(formula.gib(tagStatBaseGB), formula.gib(128)).
		staticFallback(formula.gib(tagStatBaseGB))

	tagStat := exec.builder().
		printErrStreamToStdout().
		saveStdoutStream().
		env("MI_PROGRESS_PREFIX", progressPrefix).
		software(mitoolSw).
		resources({ onCPU: { cpu: 2, ram: memFormula } }).
		arg("tag-stat").
		arg("--use-local-temp").
		arg("-t").arg(tags.cell).
		arg("-t").arg(tags.feature).
		arg("-u").arg(tags.umi).
		addFile("refined.mic", refinedMic, { tag: "mic" }).
		arg("refined.mic").arg("tagstat.tsv").saveFile("tagstat.tsv").
		run()

	return {
		tagstatTsv: tagStat.getFile("tagstat.tsv"),
		tagstatLogStream: tagStat.getStdoutStream()
	}
})
