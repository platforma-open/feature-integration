// Feature Integration -- main workflow template.
//
// FASTQ (feature-barcode) -> per-sample mitool (parse/refine/tag-stat -u) + per-cell-metrics Python
// (processColumn -> fb-pipeline.tpl.tengo) -> import the per-cell result CSVs as the per-cell contract
// p-columns keyed [pl7.app/sampleId, pl7.app/sc/cellId, pl7.app/feature/featureId], exported to the result
// pool and surfaced as a results table.
//
// processColumn's `Xsv` outputs import each per-sample CSV and prepend the sample axis from the iteration
// key, so the per-sample CSVs need only cell and feature columns. Column and axis specs live in
// column-specs.lib.tengo.

wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
render := import("@platforma-sdk/workflow-tengo:render")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
ll := import("@platforma-sdk/workflow-tengo:ll")
file := import("@platforma-sdk/workflow-tengo:file")
anonymize := import("@platforma-sdk/workflow-tengo:anonymize")
maps := import("@platforma-sdk/workflow-tengo:maps")
slices := import("@platforma-sdk/workflow-tengo:slices")
smart := import("@platforma-sdk/workflow-tengo:smart")
columnSpecs := import(":column-specs")
fanout := import(":fanout-inputs")
verdictTables := import(":verdict-tables")

times := import("times")

fbPipelineTpl := assets.importTemplate(":fb-pipeline")
prerunTpl := assets.importTemplate(":prerun")
featurePropsComputeTpl := assets.importTemplate(":fb-feature-properties-compute")
featurePropsFrameTpl := assets.importTemplate(":fb-feature-properties-frame")
exportColumnDataTpl := assets.importTemplate(":export-column-data")
verdictLinkerExportTpl := assets.importTemplate(":verdict-linker-export")
verdictComputeTpl := assets.importTemplate(":verdict-compute")
verdictDeanonymizeTpl := assets.importTemplate(":verdict-deanonymize")
verdictImportTpl := assets.importTemplate(":verdict-import")

// Per-sample mitool resource defaults. The fb-parse and fb-refine formulas add size("reads")*4 on top of
// this base and cap at 256 GiB, so the base only sets the floor for small inputs. Keep it low: mitool's
// memory-from-limits launcher derives the JVM -Xms from the grant, so a 64 GiB floor picks a ~32 GiB -Xms
// on a tiny dataset, swaps on desktop RAM, and stalls at "parsing reads". CPUs default to 8, because 16
// exceeds the core count of a typical desktop. Advanced Settings overrides both.
defaultMitoolMemGB := 16
defaultMitoolCPUs := 8

// Staging imports and exports the CSV to drive its upload before production needs it, and emits the
// feature-name list for the control dropdown.
wf.setPreRun(prerunTpl)

// Only the FASTQ dataset is resolved here, and the single-cell V(D)J dataset deliberately is NOT.
// Everything in prepare's bundle is awaited in full, spec AND data, before the body runs. Resolving the
// clonotype dataset here would leave the per-sample mitool fan-out undeclared until the whole clonotyping
// chain had finished: two chains that could run concurrently would run one after the other. The clonotype
// linker is resolved inside the verdict stage's own child templates.
wf.prepare(func(args) {
	return {
		resolvedFastq: wf.resolve(args.fbFastqRef)
	}
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()

	inputSpec := args.resolvedFastq.spec
	inputData := args.resolvedFastq.data
	sampleAxis := inputSpec.axesSpec[0] // pl7.app/sampleId — inherited verbatim
	fileExtension := inputSpec.domain["pl7.app/fileExtension"]

	// The mapping is identical for every sample, so one imported blob is shared across every per-sample body
	// invocation. The model guarantees the handle is set.
	csvImport := file.importFile(args.tagFeatureCsvHandle)
	csvFile := csvImport.file

	// Assembled and validated in the model's args() and passed through verbatim. It carries the CELL/UMI/
	// FEATURE tags and the R2 capture that refine-tags and tag-stat reference by name. Any extra flanks,
	// spacers or anchors reach mitool as-is.
	pattern := args.pattern

	// The negative-control features. They designate a per-feature marker column for downstream consumers and
	// never reach the per-sample metrics step: a four-state verdict asks the binding question of every antigen
	// independently, so there is no winner for a control to be excluded from.
	//
	// SEVERAL are allowed. Which one supplies the baseline is a different setting.
	controls := is_undefined(args.controlFeatures) ? [] : args.controlFeatures
	// Cell-barcode whitelist for refine-tags CELL correction. "" = de-novo, the default. Always a defined
	// string, so the extra-input field below resolves and never stalls the body.
	cellWhitelist := is_undefined(args.cellWhitelist) ? "" : args.cellWhitelist

	// Per-sample body inputs. processColumn binds EVERY extra key as a body input field and waits for each to
	// be set before firing the body (pframes/index.lib.tengo: `renderInputs["__extra_"+k]=v`), so a key whose
	// value is `undefined` creates a field that never resolves and stalls the body.
	//
	// A closed list, enforced below. Everything in it describes how one sample's reads are parsed and counted,
	// and nothing in it describes how the counts are read. That is what lets a change to the reading recover
	// every per-sample mitool body from cache.
	// Sample-aware mapping, optional; "" means one mapping for every sample. When set, each per-sample body
	// keeps its own sample's CSV rows, found through the key (passKey) and sampleLabels.
	sampleColumn := is_undefined(args.sampleColumn) ? "" : args.sampleColumn
	sampleAware := sampleColumn != ""
	extraInputs := {
		pattern: pattern,
		tags: args.tags, // mitool tag names (CELL/UMI/FEATURE). The one source is the model (pattern.ts).
		sampleColumn: sampleColumn,
		tagsCsv: csvFile,
		fileExtension: fileExtension,
		barcodeSeqColumn: args.barcodeSeqColumn,
		featureNameColumn: args.featureNameColumn,
		// Optional per-feature combine-mode column for multi-barcode antigens. "" = off, so every feature sums
		// its barcodes (OR). minUmi is the AND-mode per-barcode "fired" floor, always defined at 1.
		combineColumn: is_undefined(args.combineColumn) ? "" : args.combineColumn,
		minUmi: is_undefined(args.minUmi) ? 1 : args.minUmi,
		cellWhitelist: cellWhitelist
	}
	// Preview (dry-run) read cap. Only add the field when set: an undefined extra-input field creates a body
	// field that never resolves and stalls the sample. Absent means a full run, with fb-parse applying no
	// --limit.
	if !is_undefined(args.limitInput) {
		extraInputs.limitInput = args.limitInput
	}
	// Only in sample-aware mode, the one case that reads it: in any other it would put the sample id into every
	// body's identity, and another project over the same reads could not reuse the results.
	if sampleAware {
		extraInputs.sampleLabels = is_undefined(args.sampleLabels) ? {} : args.sampleLabels
	}
	// The aggregate-barcode detection knobs (qc_measures.py AGGREGATE_BARCODE_*). Same rule as limitInput
	// above. qc_report.py's own argparse default applies where absent.
	if !is_undefined(args.aggregateBarcodeIqrMultiplier) {
		extraInputs.aggregateBarcodeIqrMultiplier = args.aggregateBarcodeIqrMultiplier
	}
	if !is_undefined(args.aggregateBarcodeMinUmiThreshold) {
		extraInputs.aggregateBarcodeMinUmiThreshold = args.aggregateBarcodeMinUmiThreshold
	}
	if !is_undefined(args.aggregateBarcodeTopN) {
		extraInputs.aggregateBarcodeTopN = args.aggregateBarcodeTopN
	}

	// processColumn outputs: the per-cell contract value columns, the per-sample QC CSV collected as a
	// [sampleId] file map, and the per-sample QC-JSON map. qc-summary.tpl assembles the file map into a table,
	// because a per-sample scalar cannot be xsv-imported inside the shared processColumn.
	outputs := columnSpecs.valueOutputs(blockId, sampleAxis.name)
	outputs = append(outputs, columnSpecs.perCellSummaryOutput(blockId, sampleAxis.name))
	outputs = append(outputs, columnSpecs.qcFileMapOutput(blockId))
	outputs = append(outputs, {
		type: "Resource",
		spec: {
			kind: "PColumn",
			name: "pl7.app/feature/qcJsonFile",
			domain: { "pl7.app/blockId": blockId },
			valueType: "File"
		},
		name: "qcJson"
	})
	// Per-sample step-report map: one mitool output file per pipeline step (parse / refine / tag-stat), keyed
	// [sampleId, step]. The model derives each sample's current step from which entries are present.
	outputs = append(outputs, {
		type: "ResourceMap",
		spec: {
			kind: "PColumn",
			name: "pl7.app/feature/stepReport",
			domain: { "pl7.app/blockId": blockId },
			valueType: "File",
			axesSpec: [{ name: "pl7.app/feature/step", type: "String" }]
		},
		name: "stepReports"
	})
	// Per-sample x per-step LIVE stdout-stream map (parse / refine / tag-stat), keyed [step]. The same generic
	// pl7.app/log column peptide-extraction uses, told apart from the flat parse stream below by carrying the
	// step axis rather than a fixed step domain.
	outputs = append(outputs, {
		type: "ResourceMap",
		spec: {
			kind: "PColumn",
			name: "pl7.app/log",
			domain: { "pl7.app/blockId": blockId },
			valueType: "Log",
			axesSpec: [{ name: "pl7.app/feature/step", type: "String" }]
		},
		name: "stepLogs"
	})
	// Flat parse stdout stream: the 1-parse stream, surfaced without the step axis. It registers the moment
	// the body runs, before any sample finishes, so it drives the live parse % and the early sample roster.
	// Same pl7.app/log column, pinned to step 1-parse through the domain.
	outputs = append(outputs, {
		type: "Resource",
		spec: {
			kind: "PColumn",
			name: "pl7.app/log",
			domain: { "pl7.app/blockId": blockId, "pl7.app/feature/step": "1-parse" },
			valueType: "Log"
		},
		name: "parseLogStream"
	})
	// per-cell-metrics (Python) stdout: the "4-metrics" step log, surfaced flat and keyed [sampleId] by
	// processColumn. Kept out of the stepLogs map because fb-refine-tagstat builds that map before the metrics
	// step runs.
	outputs = append(outputs, {
		type: "Resource",
		spec: {
			kind: "PColumn",
			name: "pl7.app/log",
			domain: { "pl7.app/blockId": blockId, "pl7.app/feature/step": "4-metrics" },
			valueType: "Log"
		},
		name: "metricsLogStream"
	})
	// mitool intermediates persisted by content hash, for dedup and CID stability. A downstream consumer
	// resolving through parse, refine or tag-stat outputs walks into the streaming execs' files map, whose CID
	// drifts run to run and raises CIDConflictError. Surfacing them as content-hashed File outputs pins their
	// CIDs. No model or UI consumer: the persistence is the point. Each is a per-sample Resource, so
	// processColumn yields a [sampleId] map.
	for pn in ["parsedMic", "parseReport", "refineReport", "tagstatTsv", "rawFeatureCounts"] {
		outputs = append(outputs, {
			type: "Resource",
			spec: {
				kind: "PColumn",
				name: "pl7.app/feature/" + pn,
				domain: { "pl7.app/blockId": blockId },
				valueType: "File"
			},
			name: pn
		})
	}
	// Same content-hash persistence for the per-cell-metrics (Python) exec's file outputs. Required because
	// fb-downstream also captures that exec's stdout, and the stream makes the exec's files map rate-dependent:
	// resolving abundance or fractions through it drifts the CID and throws CIDConflictError, poisoning the
	// whole per-sample body. A `path` maps each pin to the existing body output without colliding with the Xsv
	// or File output of the same name.
	for pn in ["abundance", "fractions", "perCellSummary"] {
		outputs = append(outputs, {
			type: "Resource",
			spec: {
				kind: "PColumn",
				name: "pl7.app/feature/persist/" + pn,
				domain: { "pl7.app/blockId": blockId },
				valueType: "File"
			},
			name: pn + "Persist",
			path: [pn]
		})
	}

	// mitool resource meta, with mixcr semantics. Always pass the base memory floor. Add the override key only
	// where the user set one in Advanced Settings, so fb-pipeline treats it as a fixed request. The meta
	// differs when overridden, which is correct: it must not dedup with the formula-sized run.
	metaExtra := {
		mitoolBaseMemGB: defaultMitoolMemGB,
		mitoolCPUs: is_undefined(args.perProcessCPUs) ? defaultMitoolCPUs : args.perProcessCPUs
	}
	if !is_undefined(args.perProcessMemGB) {
		metaExtra.mitoolMemOverrideGB = args.perProcessMemGB
	}

	// Both fan-out maps are closed lists, checked here rather than reviewed later. Each key is part of every
	// per-sample body's identity, so one added key costs every user a full parse, refine-tags and tag-stat
	// re-run, and neither the render nor the logs says why. fanout-inputs.test.tengo asserts the lists exclude
	// a verdict-stage parameter and the resolved clonotype linker.
	ll.assert(len(fanout.unlisted(extraInputs, fanout.EXTRA_INPUT_KEYS)) == 0,
		"per-sample body inputs outside the allowlist: %v. Anything the verdict stage needs belongs in the verdict stage, not in the mitool fan-out.",
		fanout.unlisted(extraInputs, fanout.EXTRA_INPUT_KEYS))
	ll.assert(len(fanout.unlisted(metaExtra, fanout.META_EXTRA_KEYS)) == 0,
		"per-sample resource meta keys outside the allowlist: %v.",
		fanout.unlisted(metaExtra, fanout.META_EXTRA_KEYS))

	perSampleResults := pframes.processColumn(
		{ spec: inputSpec, data: inputData },
		fbPipelineTpl,
		outputs,
		{
			aggregate: [
				{ name: "pl7.app/sequencing/lane", optional: true },
				{ name: "pl7.app/sequencing/readIndex", optional: true }
			],
			passAggregationAxesNames: true,
			passKey: sampleAware, // the [sampleId] iteration key, for sample-aware CSV filtering only
			// Parked while measuring deduplication: a step cache returns a step regardless of identity, so it hides
			// whether the fan-out was reused on its own.
			// stepCache: 30 * times.minute,
			extra: extraInputs,
			metaExtra: metaExtra
		}
	)

	// --- assemble the per-cell p-frame, injecting a single trace ---
	trace := pSpec.makeTrace(inputSpec, {
		type: "milaboratories.feature-integration",
		id: blockId,
		importance: 30,
		label: "Feature Barcode Profiling"
	})

	addXsvTo := func(fb, outputName) {
		for col in perSampleResults.listXsvColumns(outputName) {
			fb.add(
				outputName + "/" + col,
				trace.inject(perSampleResults.outputSpec(outputName, col)),
				perSampleResults.outputData(outputName, col)
			)
		}
	}

	// Exported per-cell contract frame. The full per-(cell x feature) matrix, UNCHANGED by the table collapse
	// below: downstream still consumes abundance and fractions at [sampleId, cellId, featureId].
	fb := pframes.pFrameBuilder()
	addXsvTo(fb, "abundance")
	addXsvTo(fb, "fractions")
	finalPf := fb.build()

	// Main results table, table-only: one row per [sampleId, cellId]. Collapses the matrix above for display,
	// leaving the export contract unaffected.
	// Its data is exported in a pure template (export-column-data.tpl.tengo), so a later run reuses the export
	// and main surfaces the frame without pframes.exportFrame.
	perCellSummaryColumns := perSampleResults.listXsvColumns("perCellSummary")
	perCellExportInputs := {}
	for col in perCellSummaryColumns {
		perCellExportInputs["column." + col] = perSampleResults.outputData("perCellSummary", col)
	}
	perCellExport := render.create(exportColumnDataTpl, perCellExportInputs)
	tableFb := pframes.pFrameBuilder()
	for col in perCellSummaryColumns {
		tableFb.add(
			"perCellSummary/" + col,
			trace.inject(perSampleResults.outputSpec("perCellSummary", col)),
			perCellExport.resolveOutput(["data", col])
		)
	}
	tablePf := tableFb.build()

	// --- per-feature properties ---
	// The exec and its import run in a pure template (fb-feature-properties-compute.tpl.tengo). The ephemeral
	// frame stage then attaches the specs, which carry blockId.
	hasControl := len(controls) > 0
	featurePropsData := render.create(featurePropsComputeTpl, {
		tagsCsv: csvFile,
		barcodeSeqColumn: args.barcodeSeqColumn,
		featureNameColumn: args.featureNameColumn,
		// Excluded from the properties: it is a role, not a property.
		sampleColumn: sampleColumn,
		controls: controls
	})
	featurePropsResult := render.createEphemeral(featurePropsFrameTpl, {
		propertyData: featurePropsData.output("propertyData"),
		controlData: featurePropsData.output("controlData"),
		propertyMeta: featurePropsData.output("propertyMeta"),
		hasControl: hasControl,
		blockId: blockId,
		traceSeedSpec: inputSpec
	})

	// --- the verdict stage ---
	//
	// Conditional on a chosen single-cell V(D)J dataset. Without one there is no clonotype set for a verdict to
	// be about, and no way to say which receptor's linker the reading would be answered against, since the
	// linker query is scoped by that dataset's anchor.
	//
	// UNREACHABLE from the app: `args()` refuses a run with no dataset, since verdicts are what this block
	// is for and a settings-knowable refusal belongs there. Kept as a guard rather than deleted, so a
	// hand-driven render emits the per-cell contract columns, the per-sample QC and the per-feature
	// properties instead of failing on an absent input. `types.ts` records the same.
	verdictCompute := undefined
	verdictDeanonymized := undefined
	verdictImport := undefined
	if !is_undefined(args.datasetRef) {
		// The three per-sample maps the verdict stage reads, with their sample keys anonymized in one call, so a
		// sample gets the same key in all three. The key is derived from the sample's content, so another project
		// over the same reads gets the same keys and reuses the compute below.
		anonymized := anonymize.anonymizePKeys({
			tagstat: perSampleResults.outputData("tagstatTsv"),
			rawFeatureCounts: perSampleResults.outputData("rawFeatureCounts"),
			qc: perSampleResults.outputData("qc")
		}, [0])
		sampleMapping := anonymized.mapping

		// Built HERE, in the body, and not in prepare -- see the note on wf.prepare above. The bundle is passed to
		// both child templates unresolved. A resolved bundle is a map with methods, which cannot be serialized as
		// a template input, so each template resolves it for itself.
		bundleBuilder := wf.createPBundleBuilder()
		bundleBuilder.ignoreMissingDomains()
		bundleBuilder.addAnchor("main", args.datasetRef)
		// Resolved by NAME as a MULTI query, because the linker is infrastructure: it carries
		// pl7.app/isLinkerColumn and is hidden in tables, so no user can pick it. A dataset may bring one linker
		// per receptor, and verdict-linker.lib.tengo selects the one whose clonotype axis IS the anchor's.
		bundleBuilder.addMulti({ name: "pl7.app/sc/cellLinker" }, "linker")
		verdictBundle := bundleBuilder.build()

		// The linker as a CSV, and the sample-label map, keyed by anonymized sample ids.
		linkerExport := render.createEphemeral(verdictLinkerExportTpl, {
			columns: verdictBundle,
			datasetRef: args.datasetRef,
			sampleAxisSpec: sampleAxis,
			mapping: sampleMapping,
			sampleLabels: is_undefined(args.sampleLabels) ? {} : args.sampleLabels
		})

		// Only the reading's own parameters, and nothing that touched the fan-out. The sample-label map comes
		// from the linker export instead.
		verdictParams := {
			barcodeSeqColumn: args.barcodeSeqColumn,
			featureNameColumn: args.featureNameColumn,
			sampleColumn: sampleColumn
		}
		// Optional parameters are ADDED, never defaulted to undefined. verdict-args tells an absent value -- leave
		// the CLI's own default, or leave the line off -- apart from a supplied one, and a key whose value crosses
		// a template boundary as undefined arrives back as JSON null, a third thing neither side means.
		setParam := func(key, value) {
			if !is_undefined(value) {
				verdictParams[key] = value
			}
		}
		setParam("roleColumn", args.roleColumn)
		setParam("referenceValues", args.referenceValues)
		setParam("referenceSource", args.referenceSource)
		setParam("panelReferenceMinMembers", args.panelReferenceMinMembers)
		setParam("distributionMinCells", args.distributionMinCells)
		setParam("countFloor", args.countFloor)
		setParam("boundCutoff", args.boundCutoff)
		setParam("boundProbability", args.boundProbability)
		setParam("expectedBinderFraction", args.expectedBinderFraction)
		setParam("minVotingCells", args.minVotingCells)
		setParam("minAgreement", args.minAgreement)
		setParam("gateThreshold", args.gateThreshold)
		setParam("grouping", args.grouping)
		setParam("contendingGroups", args.contendingGroups)
		setParam("captureMap", args.captureMap)
		setParam("panelAssignedWarn", args.panelAssignedWarn)
		setParam("panelAssignedError", args.panelAssignedError)
		setParam("matchRateWarn", args.matchRateWarn)
		setParam("matchRateError", args.matchRateError)
		setParam("cellBarcodeQualityWarn", args.cellBarcodeQualityWarn)
		setParam("cellBarcodeQualityError", args.cellBarcodeQualityError)
		setParam("readsPerCellWarn", args.readsPerCellWarn)
		setParam("aggregateBarcodeWarn", args.aggregateBarcodeWarn)
		setParam("aggregateBarcodeError", args.aggregateBarcodeError)
		setParam("undeclaredBarcodeWarn", args.undeclaredBarcodeWarn)
		setParam("undeclaredBarcodeError", args.undeclaredBarcodeError)
		setParam("usableReadWarn", args.usableReadWarn)
		setParam("usableReadError", args.usableReadError)
		setParam("rescuedShareWarn", args.rescuedShareWarn)
		setParam("rescuedShareError", args.rescuedShareError)
		setParam("vdjAntigenCountWarn", args.vdjAntigenCountWarn)
		setParam("vdjAntigenCountError", args.vdjAntigenCountError)

		// The gathers and the verdict exec. Its outputs are kept in resultsToCache so a later run can reuse them.
		verdictCompute = render.create(verdictComputeTpl, {
			tagstatData: anonymized.result.tagstat,
			rawFeatureData: anonymized.result.rawFeatureCounts,
			qcData: anonymized.result.qc,
			tags: args.tags,
			panelFile: csvFile,
			linkerFile: linkerExport.output("linkerFile"),
			sampleLabels: linkerExport.output("sampleLabels"),
			params: verdictParams
		})

		// Translates every result that carries sample ids back to this project's ids, with the linker export's
		// mapping (the anonymization's plus any V(D)J-only samples).
		deanonymizeInputs := { mapping: linkerExport.output("mapping") }
		for name in verdictTables.SAMPLE_ID_TABLES {
			deanonymizeInputs[name] = verdictCompute.output(name)
		}
		for name in maps.getKeys(verdictTables.SAMPLE_ID_LIST_COLUMNS) {
			deanonymizeInputs[name] = verdictCompute.output(name)
		}
		for content in verdictTables.CONTENT_OUTPUTS {
			deanonymizeInputs[content.out] = verdictCompute.output(content.out)
		}
		verdictDeanonymized = render.createEphemeral(verdictDeanonymizeTpl, deanonymizeInputs)

		// A verdict result, translated when it carries sample ids.
		verdictResult := func(name) {
			if slices.hasElement(verdictTables.SAMPLE_ID_TABLES, name) ||
				!is_undefined(verdictTables.SAMPLE_ID_LIST_COLUMNS[name]) {
				return verdictDeanonymized.output(name)
			}
			return verdictCompute.output(name)
		}

		// The import takes the run record as an INPUT so the specs it builds carry the comparator that actually
		// SERVED. The software degrades a request it cannot honour, and that choice sits in the emitted columns'
		// domain. Specs built inside the exec's own template would record the request instead.
		// Every saved verdict table. result_cell_counts.csv, the post-floor per-cell per-tag counts, is not among
		// them (verdict-tables.lib.tengo).
		verdictImportInputs := {
			columns: verdictBundle,
			datasetRef: args.datasetRef,
			blockId: blockId,
			sampleAxisSpec: sampleAxis,
			traceSeedSpec: inputSpec,
			runMeta: verdictDeanonymized.output("runMeta")
		}
		for table in verdictTables.RESULT_TABLES {
			verdictImportInputs[table.out] = verdictResult(table.out)
		}
		verdictImport = render.createEphemeral(verdictImportTpl, verdictImportInputs)
	}

	blockOutputs := {
		// Collapsed per-cell results table (one row per [sampleId, cellId]).
		perCellTable: tablePf,
		// Per-sample QC metrics as JSON (fb-pipeline qcJson). The model builds the live "Analysis logs" from it.
		qcJson: perSampleResults.outputData("qcJson"),
		// Per-sample QC CSV map (fb-pipeline `qc`). Kept so the per-sample body can be reused: that needs every
		// one of its outputs to still exist. No model consumer.
		qc: perSampleResults.outputData("qc"),
		// Per-sample x per-step report-file map. The model derives each sample's current step from which reports
		// are present.
		stepReports: perSampleResults.outputData("stepReports"),
		// Per-sample x per-step LIVE stdout-stream map -> model per-step log handles + live progress.
		stepLogs: perSampleResults.outputData("stepLogs"),
		// Flat parse stdout stream -> model live parse % + early sample roster (registers first).
		parseLogStream: perSampleResults.outputData("parseLogStream"),
		// per-cell-metrics (Python) stdout -> model 4-metrics step log.
		metricsLogStream: perSampleResults.outputData("metricsLogStream"),
		// mitool intermediates kept reachable so they are persisted by content hash. See the output-spec note
		// above. No model or UI consumer.
		parsedMic: perSampleResults.outputData("parsedMic"),
		parseReport: perSampleResults.outputData("parseReport"),
		refineReport: perSampleResults.outputData("refineReport"),
		tagstatTsv: perSampleResults.outputData("tagstatTsv"),
		rawFeatureCounts: perSampleResults.outputData("rawFeatureCounts"),
		// metrics-exec file outputs kept reachable so they are content-hash-persisted, per the persist loop
		// above. This is what makes capturing the metrics stdout CID-safe. No model consumer.
		abundancePersist: perSampleResults.outputData("abundancePersist"),
		fractionsPersist: perSampleResults.outputData("fractionsPersist"),
		perCellSummaryPersist: perSampleResults.outputData("perCellSummaryPersist"),
		// Expose the tag->feature CSV import HANDLE so the model can watch it through getImportProgress(). That
		// model output is the upload driver: it registers the import with the middle-layer so the CSV bytes are
		// pushed. Without it the CSV blob never materialises and every per-sample body hangs on __extra_tagsCsv.
		tagFeatureCsvImportHandle: csvImport.handle
	}

	// Template outputs kept only so a later run can reuse those templates: a pure template is reused when
	// every one of its outputs still exists, and nothing else holds these. Most only point at data the frames
	// and exports already hold; verdictCompute holds its own files. No model consumer.
	resultsToCache := {
		// export-column-data's result for perCellTable.
		perCellTable: perCellExport.output("data"),
		// Every fb-feature-properties-compute output.
		featureProperties: smart.createMapResource({
			propertyData: featurePropsData.output("propertyData"),
			controlData: featurePropsData.output("controlData"),
			propertyMeta: featurePropsData.output("propertyMeta")
		})
	}

	blockExports := {
		perCellFeatures: finalPf,
		// Per-feature properties, keyed on the shared feature axis (pl7.app/feature/featureId). A separate frame
		// keeps the per-cell contract above unchanged, and the result pool is flat, so these are discoverable and
		// joinable by the feature axis downstream. VDJ Multiomic Integration reuses this exact feature axis.
		// Empty where the CSV has no extra columns.
		featureProperties: featurePropsResult.output("featureProperties")
	}

	// Only present where a V(D)J dataset was chosen. A template output field cannot be assigned undefined, so
	// the verdict results are added rather than defaulted.
	if !is_undefined(verdictImport) {
		// Everything a downstream block joins to: the verdicts, the set-keyed counts that are the only family
		// lead selection can see, the pivoted per-identity summary, the offered scope, the tag -> identity linker
		// and the label columns.
		//
		// Labelling and lead selection both read verdicts, never cells, so no per-cell material is among the
		// families they join to. The per-cell reference readings are reported as an OUTPUT below instead.
		blockExports.antigenVerdicts = verdictImport.output("antigenVerdicts")
		// The one exported per-cell family: the pre-floor per-tag capture, in BOTH shapes -- long, keyed
		// (sample, cell, tag), and pivoted onto the cell with one column per barcode. Exported for plotting
		blockExports.antigenCellTagCounts = verdictImport.output("cellTagCounts")
		// The same frame as an OUTPUT, because a block's own exports are not in its own result pool. Without
		// this the block that produced the verdicts would be the one place that cannot read them.
		//
		// Read by the model's expansion table (one clonotype's identities, down the page), which needs the
		// verdicts unpivoted. The punchcard reads the pivoted frame below instead, because a table cannot turn a
		// (set, identity) frame into one column per identity.
		blockOutputs.antigenVerdictsTable = pframes.exportFrame(verdictImport.output("antigenVerdicts"))
		// The punchcard's source: the same verdicts pivoted onto the clonotype set, one column per identity for
		// the state and one for the support behind it. A table cannot pivot a (set, identity) frame into
		// columns, so the shape the punchcard needs is built here rather than in the model.
		// Built from already-exported data (verdict-output-data.tpl.tengo), like the verdict output frames below,
		// so it is surfaced without pframes.exportFrame.
		blockOutputs.antigenPunchcardTable = verdictImport.output("punchcard")
		// verdict-output-data's result per output table.
		resultsToCache.verdictOutputTables = verdictImport.output("outputTablesData")
		// The run's own report. Outputs rather than exports: these are read by this block's model and UI.
		//
		// One row per sample, one column per sample-level measurement, carrying that sample's rolled-up status.
		// Gated behind a chosen V(D)J dataset, unlike the earlier mitool-only qcSummaryTable it replaces: the
		// rolled-up status comes from the verdict stage, and that stage has no clonotype set to run against
		// until a dataset is picked.
		blockOutputs.qcSummaryTable = verdictImport.output("qcSummaryTable")
		// Barcodes the reads carried that no panel declares, keyed by sequence, carrying the one status this
		// run's quality surface publishes outside the measurement list -- the share of a sample's reads landing
		// in undeclared barcodes. Usually empty.
		blockOutputs.antigenUndeclaredBarcodesTable = verdictImport.output("undeclaredBarcodesTable")
		// The fitted backgrounds, at the fit's own (sample, tag) grain. Named for what it holds: it carried
		// two decile frames as well until nothing turned out to plot either. Outputs rather than exports,
		// like the report above -- nothing downstream reads it.
		blockOutputs.antigenBackgrounds = verdictImport.output("backgroundsFrame")
		blockOutputs.antigenReagentTable = verdictImport.output("reagentTable")
		// The per-cell reference readings, kept inside the block. One row per cell: the reading itself, and
		// whether a declared gate set the cell aside. A reader checks here why a cell could or could not be
		// compared, and here the block reports the cells carrying a high reference reading whether or not a gate
		// was declared.
		//
		// Named for what it holds rather than for its grain: it is not a table of cells. The per-cell per-tag
		// counts are not built at all, because no reader exists for them on either side of the boundary and they
		// are the run's largest table.
		blockOutputs.antigenCellReference = verdictImport.output("cellReference")
		// What the run was answered under, including the comparator and cell list that actually served and every
		// parameter the reading used. Read as content by the model.
		blockOutputs.antigenRunMeta = verdictDeanonymized.output("runMeta")
		// Every sample-level quality measurement, keyed by sample, with that sample's rolled-up status and
		// coverage. Read as content. The only source for both the Main grid's Quality tag and the sample detail
		// view's Quality Checks tab.
		blockOutputs.antigenSampleQc = verdictDeanonymized.output("qcBySample")
		// Binned count distributions per (sample, tag), taken from the raw counts, with the one edge list they
		// share. Content rather than a p-frame: the chart takes its bins as values in the UI, so a frame handle
		// would only have to be read back out again.
		blockOutputs.antigenTagBins = verdictDeanonymized.output("qcTagBins")
		// Every verdict-compute output, as computed. Real files, which only this holds.
		verdictComputeOutputs := {}
		for table in verdictTables.RESULT_TABLES {
			verdictComputeOutputs[table.out] = verdictCompute.output(table.out)
		}
		for content in verdictTables.CONTENT_OUTPUTS {
			verdictComputeOutputs[content.out] = verdictCompute.output(content.out)
		}
		resultsToCache.verdictCompute = smart.createMapResource(verdictComputeOutputs)
	}

	blockOutputs.resultsToCache = smart.createMapResource(resultsToCache)

	return {
		outputs: blockOutputs,
		exports: blockExports
	}
})
