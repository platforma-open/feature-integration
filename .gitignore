# Manual / exploration test-data: track only the reproducible recipe — generators
# (*.py), docs (*.md), and any non-regenerable harvested input (whitelist_cells.txt).
# All generated data is ignored; regenerate with each dir's generator (see its README).
# test/assets/ and software/test-data/feature-synthetic/ are used by automated tests
# and stay fully tracked, so they are intentionally not listed here.
software/test-data/manual-run/**
!software/test-data/manual-run/**/
!software/test-data/manual-run/**/*.py
!software/test-data/manual-run/**/*.md

software/test-data/feature-integration-synthetic/**
!software/test-data/feature-integration-synthetic/**/
!software/test-data/feature-integration-synthetic/**/*.py
!software/test-data/feature-integration-synthetic/**/*.md
!software/test-data/feature-integration-synthetic/whitelist_cells.txt

software/test-data/multiomics-run/**
!software/test-data/multiomics-run/**/
!software/test-data/multiomics-run/**/*.py
!software/test-data/multiomics-run/**/*.md

# Local working docs / scratch — not version-controlled
docs/superpowers/
.meta/handover/
